\usetikzlibrary{calc,arrows.meta,decorations.markings}
\newcommand\minn[1]{
\draw[draw=blue,fill=white,thick] (#1) circle (.1);
\draw[draw=blue,fill=white,thick] (#1) circle (.05);
}
\newcommand\sadd[1]{
\draw[dgren,fill=white,thick] (#1) circle (.1);
\foreach \r in {0,90,180,270}{
  \draw[dgren,thick] (#1)--++(\r:.1);
}
}
\newcommand\maxx[1]{
\draw[draw=red,fill=white,thick] (#1) circle (.1);
\fill[fill=red] (#1) circle (.05);
}
\newcommand\spacer{16pt}      % for neighborhood spacing of moves
\newcommand\twospacer{32pt}   % twice the previous
\newcommand\elen{1.4}         % for edge length of moves
\newcommand\bwid{.3}          % bar width for embedding pictures
\newcommand\hfactor{8}        % spacing factor for embedding pictures
\newcommand\levelspacer{1.2}   % spacing factor for exploded nesting poset analysis

